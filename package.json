{
  "name": "intra-success-academy",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"npm run dev -w apps/web\" \"npm run dev -w apps/worker\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:worker": "npm run dev -w apps/worker",
    "build": "npm run build -w packages/db && npm run build -w apps/web && npm run build -w apps/worker",
    "start": "npm run start -w apps/web",
    "start:worker": "npm run start -w apps/worker",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w packages/db",
    "db:migrate": "npm run db:migrate -w packages/db",
    "db:migrate:deploy": "npm run db:migrate:deploy -w packages/db",
    "db:studio": "npm run db:studio -w packages/db",
    "db:seed": "npm run db:seed -w packages/db",
    "postinstall": "npm run build -w packages/db"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "dotenv-cli": "^7.4.4",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@prisma/client": "5.22.0"
  }
}
