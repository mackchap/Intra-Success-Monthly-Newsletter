# =============================================================================
# Intra Success Academy — environment variables
# Copy this file to `.env` for local dev. Never commit the real `.env`.
# In Railway, set these as service variables (Project → Service → Variables).
# =============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
# Public base URL of the web app. Local: http://localhost:3000
# Railway: your generated domain, e.g. https://intra-success-academy.up.railway.app
APP_URL=http://localhost:3000

# --- Database (Postgres) -----------------------------------------------------
# Local dev: Docker Postgres (see docker-compose.yml)
# Railway: provided automatically by the Railway Postgres plugin as DATABASE_URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intra_success_academy?schema=public

# --- Redis (BullMQ queues for the worker service) ----------------------------
# Local dev: Docker Redis (see docker-compose.yml)
# Railway: provided automatically by the Railway Redis plugin as REDIS_URL
REDIS_URL=redis://localhost:6379

# --- Auth (Auth.js / NextAuth) ------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-random-32-byte-secret
# Auth.js v5 reads AUTH_URL; keep in sync with APP_URL in production.
AUTH_URL=http://localhost:3000

# --- Stripe -------------------------------------------------------------------
# Test mode keys first (sk_test_ / pk_test_). Switch to live keys (sk_live_ / pk_live_)
# only after the runbook's "Go live" checklist in CLAUDE.md is complete.
STRIPE_SECRET_KEY=<your-stripe-test-secret-key>
STRIPE_PUBLISHABLE_KEY=<your-stripe-test-publishable-key>
# From `stripe listen` locally, or the Railway webhook endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-signing-secret>

# --- Email (Resend) ------------------------------------------------------------
RESEND_API_KEY=<your-resend-api-key>
EMAIL_FROM="Intra Success Academy <hello@yourdomain.com>"

# --- SMS (Twilio) ---------------------------------------------------------------
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_FROM_NUMBER=+15555550100

# --- Video hosting (Mux) ---------------------------------------------------------
MUX_TOKEN_ID=<your-mux-token-id>
MUX_TOKEN_SECRET=<your-mux-token-secret>
# Optional fallback / alternative provider
VIMEO_ACCESS_TOKEN=

# --- File storage (Cloudflare R2 — S3-compatible) --------------------------------
R2_ACCOUNT_ID=<your-r2-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=intra-success-academy
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# --- AI agents (Anthropic API) -----------------------------------------------
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# --- Worker service only -------------------------------------------------------
# Set to "true" only on the Railway worker service so it doesn't also try to
# serve HTTP traffic; the web service should leave this unset.
WORKER_ONLY=false
