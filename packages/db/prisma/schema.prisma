// Intra Success Academy — database schema
// Covers: auth, CRM, funnels + automation, academy/courses, orders/payments.
// See CLAUDE.md for conventions (money stored as integer cents, soft deletes
// avoided in favor of status enums, etc).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Auth (Auth.js / NextAuth — PrismaAdapter shape) + tenancy
//
// Phase 8 introduced multi-tenancy: `Account` is a tenant (one of your
// customers' businesses running on this platform, e.g. one HighLevel
// "sub-account" equivalent). A `User` no longer has one global role — they
// hold a `Membership` (with a role) per `Account` they belong to, since the
// same person can own or staff more than one tenant. `User.isPlatformAdmin`
// is the separate, orthogonal meta-level flag for *your* team managing every
// tenant from `/platform-admin` — it has nothing to do with any Membership.
// See CLAUDE.md's Phase 8 section for the full rationale (including why
// Funnels/Academy/Marketing/Orders are NOT yet tenant-scoped).
// =============================================================================

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  password        String? // bcrypt hash; null for OAuth-only users
  isPlatformAdmin Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]

  // CRM: a portal user may be linked to exactly one CRM contact
  contact Contact?

  // CRM ownership (staff/admin)
  ownedContacts Contact[]  @relation("ContactOwner")
  ownedDeals    Deal[]     @relation("DealOwner")
  assignedTasks Task[]     @relation("TaskAssignee")
  authoredNotes Note[]     @relation("NoteAuthor")
  activities    Activity[] @relation("ActivityActor")

  // Academy
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  certificates   Certificate[]

  // Orders / billing
  orders          Order[]
  subscriptions   Subscription[]
  tenantCustomers TenantCustomer[]

  // Marketing
  connectedSocialAccounts SocialAccount[]
  createdCampaigns        Campaign[]
  approvedSocialPosts     SocialPost[]

  // Directory (Phase 10)
  claimedListings Listing[]

  @@index([isPlatformAdmin])
}

// Auth.js's own OAuth account-link table — @auth/prisma-adapter hardcodes
// the Prisma Client accessor name `prisma.account`, so this model MUST stay
// named `Account` regardless of what we call the Phase 8 tenant concept
// below (named `Tenant` specifically to avoid colliding with this).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
  CUSTOMER
}

// A tenant — one of your customers' businesses running on this platform
// (the equivalent of a HighLevel "sub-account"/"location"). Called `Tenant`
// rather than `Account` purely because Auth.js's adapter already owns that
// name above; UI copy and route segments still say "Account" since that's
// the natural business term. Every tenant-scoped model below carries a
// `tenantId` FK to this. See CLAUDE.md's Phase 8 section for which modules
// are tenant-scoped so far.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // This tenant's OWN connected Stripe account. Their customers' payments
  // (course sales, listing upgrades, funnel offers — once those modules are
  // tenant-scoped in Phase 9) settle here, never in the platform's own
  // Stripe account — see CLAUDE.md for why Stripe Connect, not one shared
  // Stripe account, is non-negotiable once tenants are real businesses.
  stripeConnectAccountId String?             @unique
  stripeConnectStatus    StripeConnectStatus @default(NOT_CONNECTED)
  chargesEnabled         Boolean             @default(false)

  memberships          Membership[]
  platformSubscription PlatformSubscription?

  contacts   Contact[]
  companies  Company[]
  pipelines  Pipeline[]
  deals      Deal[]
  tasks      Task[]
  notes      Note[]
  activities Activity[]

  // Phase 9
  funnels         Funnel[]
  sequences       Sequence[]
  courses         Course[]
  products        Product[]
  orders          Order[]
  subscriptions   Subscription[]
  tenantCustomers TenantCustomer[]
  socialAccounts  SocialAccount[]
  campaigns       Campaign[]

  // Phase 10
  directory Directory?
  listings  Listing[]

  @@index([slug])
}

// A User's role within one specific Tenant. A user with no Membership on a
// Tenant has no access to it at all, regardless of any other Membership
// they hold elsewhere — this is the whole tenant isolation boundary.
model Membership {
  id        String         @id @default(cuid())
  role      MembershipRole @default(STAFF)
  createdAt DateTime       @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

enum StripeConnectStatus {
  NOT_CONNECTED
  PENDING
  ACTIVE
  RESTRICTED
}

enum PlatformPlan {
  TRIAL
  STANDARD
}

enum PlatformSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

// The Tenant's OWN subscription to *this platform* (what you charge a
// tenant to use Marlow/Kelvo) — completely separate from anything the
// tenant charges their own customers via their connected Stripe account
// above. Lives on the platform's Stripe account, never Connect.
model PlatformSubscription {
  id                   String                     @id @default(cuid())
  plan                 PlatformPlan               @default(TRIAL)
  status               PlatformSubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?                    @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean                    @default(false)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================================================
// CRM: contacts, companies, deals/pipeline, tasks, notes, activity timeline
// =============================================================================

model Company {
  id        String   @id @default(cuid())
  name      String
  domain    String?
  industry  String?
  website   String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contacts Contact[]
  deals    Deal[]

  @@index([tenantId, name])
}

model Contact {
  id           String   @id @default(cuid())
  email        String
  firstName    String?
  lastName     String?
  phone        String?
  source       String? // e.g. "funnel:evergreen-webinar", "manual", "import"
  tags         String[] @default([])
  customFields Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  ownerId String?
  owner   User?   @relation("ContactOwner", fields: [ownerId], references: [id])

  // Set once this contact creates a portal account (student/customer login).
  // Global, not tenantId-scoped — Academy/portal logins aren't tenant-scoped
  // until Phase 9, so one User can only ever back one Contact platform-wide
  // for now.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  deals               Deal[]
  tasks               Task[]
  notes               Note[]
  activities          Activity[]
  funnelSubmissions   FunnelSubmission[]
  funnelVisits        FunnelVisit[]
  sequenceEnrollments SequenceEnrollment[]
  messageLogs         MessageLog[]
  orders              Order[]

  // Same email can be a customer of two different tenants, so uniqueness
  // moved from global to per-account with Phase 8.
  @@unique([tenantId, email])
  @@index([companyId])
  @@index([ownerId])
}

enum DealStatus {
  OPEN
  WON
  LOST
}

model Pipeline {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  stages PipelineStage[]
  deals  Deal[]

  @@index([tenantId])
}

model PipelineStage {
  id          String  @id @default(cuid())
  name        String
  order       Int
  probability Int? // 0-100, indicative likelihood of closing from this stage
  // Moving a deal into a stage with either flag set closes it: sets
  // Deal.status/closedAt and logs a DEAL_WON/DEAL_LOST activity.
  isWon       Boolean @default(false)
  isLost      Boolean @default(false)

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  deals Deal[]

  @@unique([pipelineId, order])
  @@index([pipelineId])
}

model Deal {
  id         String     @id @default(cuid())
  title      String
  valueCents Int        @default(0)
  currency   String     @default("usd")
  status     DealStatus @default(OPEN)
  closedAt   DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  ownerId String?
  owner   User?   @relation("DealOwner", fields: [ownerId], references: [id])

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id])

  stageId String
  stage   PipelineStage @relation(fields: [stageId], references: [id])

  // Set when a deal originates from a funnel lead capture / checkout
  funnelId String?
  funnel   Funnel? @relation(fields: [funnelId], references: [id])

  tasks      Task[]
  notes      Note[]
  activities Activity[]
  orders     Order[]

  @@index([tenantId])
  @@index([contactId])
  @@index([stageId])
  @@index([status])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id])

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id])

  @@index([tenantId])
  @@index([assignedToId])
  @@index([contactId])
  @@index([dealId])
}

model Note {
  id        String   @id @default(cuid())
  body      String   @db.Text
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("NoteAuthor", fields: [authorId], references: [id])

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id])

  @@index([tenantId])
  @@index([contactId])
  @@index([dealId])
}

enum ActivityType {
  NOTE_ADDED
  TASK_CREATED
  TASK_COMPLETED
  STAGE_CHANGED
  DEAL_CREATED
  DEAL_WON
  DEAL_LOST
  EMAIL_SENT
  SMS_SENT
  CALL_LOGGED
  MEETING_LOGGED
  FUNNEL_SUBMISSION
  ORDER_PAID
  SYSTEM
}

// Append-only activity timeline for a contact/deal.
model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  metadata  Json?
  createdAt DateTime     @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation("ActivityActor", fields: [actorId], references: [id])

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id])

  @@index([tenantId, createdAt])
  @@index([contactId, createdAt])
  @@index([dealId, createdAt])
}

// =============================================================================
// Funnels: landing pages, lead capture, multi-step sales funnels + automation
// =============================================================================

enum FunnelStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FunnelStepType {
  AD
  LANDING
  OPT_IN
  OFFER
  CHECKOUT
  UPSELL
  THANK_YOU
  CUSTOM
}

model Funnel {
  id          String       @id @default(cuid())
  name        String
  slug        String
  description String?
  status      FunnelStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  steps       FunnelStep[]
  deals       Deal[]
  visits      FunnelVisit[]
  submissions FunnelSubmission[]
  sequences   Sequence[]
  orders      Order[]

  // Slugs are only unique per tenant now (Phase 9) — public funnel URLs are
  // tenant-scoped (`/t/[tenantSlug]/f/[funnelSlug]/...`), so two tenants can
  // each have their own "free-guide" funnel.
  @@unique([tenantId, slug])
}

// A step IS a page: its `content` holds the builder's page JSON (blocks/layout).
model FunnelStep {
  id      String         @id @default(cuid())
  type    FunnelStepType
  name    String
  slug    String
  order   Int
  content Json? // page builder JSON — structure owned by the funnel builder UI

  funnelId String
  funnel   Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  visits      FunnelVisit[]
  submissions FunnelSubmission[]

  @@unique([funnelId, slug])
  @@unique([funnelId, order])
  @@index([funnelId])
}

// One row per page view — the raw material for visits/conversion/drop-off analytics.
model FunnelVisit {
  id          String   @id @default(cuid())
  sessionId   String // anonymous visitor/session id (cookie-based)
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())

  funnelId String
  funnel   Funnel @relation(fields: [funnelId], references: [id])

  funnelStepId String
  funnelStep   FunnelStep @relation(fields: [funnelStepId], references: [id])

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  @@index([funnelId, funnelStepId, createdAt])
  @@index([sessionId])
}

// A lead-capture form submission; writes/links a Contact (+ optionally a Deal).
model FunnelSubmission {
  id        String   @id @default(cuid())
  data      Json // raw form fields submitted
  createdAt DateTime @default(now())

  funnelId String
  funnel   Funnel @relation(fields: [funnelId], references: [id])

  funnelStepId String
  funnelStep   FunnelStep @relation(fields: [funnelStepId], references: [id])

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  @@index([funnelId, createdAt])
  @@index([contactId])
}

// --- Automation sequences (email/SMS), provider-agnostic -------------------

enum SequenceTrigger {
  FUNNEL_STAGE_ENTERED
  ABANDONED_CHECKOUT
  WELCOME
  MANUAL
}

model Sequence {
  id        String          @id @default(cuid())
  name      String
  trigger   SequenceTrigger
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  funnelId String?
  funnel   Funnel? @relation(fields: [funnelId], references: [id])

  steps       SequenceStep[]
  enrollments SequenceEnrollment[]

  @@index([tenantId])
  @@index([funnelId])
}

enum MessageChannel {
  EMAIL
  SMS
}

model SequenceStep {
  id           String         @id @default(cuid())
  order        Int
  channel      MessageChannel
  delayMinutes Int            @default(0) // delay after previous step (or enrollment)
  subject      String? // email only
  body         String         @db.Text

  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  messageLogs MessageLog[]

  @@unique([sequenceId, order])
  @@index([sequenceId])
}

enum SequenceEnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELED
}

model SequenceEnrollment {
  id               String                   @id @default(cuid())
  status           SequenceEnrollmentStatus @default(ACTIVE)
  currentStepOrder Int                      @default(0)
  startedAt        DateTime                 @default(now())
  completedAt      DateTime?

  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id])

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  @@unique([sequenceId, contactId])
  @@index([contactId])
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

// Provider-agnostic send log (Resend for email, Twilio for SMS today).
model MessageLog {
  id                String         @id @default(cuid())
  channel           MessageChannel
  provider          String // "resend" | "twilio" | future providers
  providerMessageId String?
  status            MessageStatus  @default(QUEUED)
  error             String?
  sentAt            DateTime?
  createdAt         DateTime       @default(now())

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  sequenceStepId String?
  sequenceStep   SequenceStep? @relation(fields: [sequenceStepId], references: [id])

  @@index([contactId])
}

// =============================================================================
// Academy: courses → modules → lessons, enrollment, progress, certificates
// =============================================================================

enum CoursePriceType {
  FREE
  PAID
  MEMBERSHIP
}

model Course {
  id              String          @id @default(cuid())
  title           String
  slug            String
  description     String?         @db.Text
  priceType       CoursePriceType @default(PAID)
  priceCents      Int             @default(0)
  published       Boolean         @default(false)
  stripeProductId String?
  stripePriceId   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  modules      Module[]
  enrollments  Enrollment[]
  certificates Certificate[]
  orders       Order[]
  products     Product[]

  prerequisites Course[] @relation("CoursePrerequisites")
  requiredFor   Course[] @relation("CoursePrerequisites")

  // Slugs are only unique per tenant now (Phase 9) — public course URLs are
  // tenant-scoped (`/t/[tenantSlug]/courses/[slug]`).
  @@unique([tenantId, slug])
  @@index([tenantId, published])
}

model Module {
  id    String @id @default(cuid())
  title String
  order Int

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  @@unique([courseId, order])
  @@index([courseId])
}

enum LessonType {
  VIDEO
  TEXT
  DOWNLOAD
  QUIZ
}

enum VideoProvider {
  MUX
  VIMEO
}

model Lesson {
  id            String         @id @default(cuid())
  title         String
  order         Int
  type          LessonType
  content       String?        @db.Text // rich text for TEXT lessons, instructions for others
  videoProvider VideoProvider?
  videoId       String? // Mux playback ID or Vimeo video ID
  dripDelayDays Int? // days after enrollment before this lesson unlocks; null = immediate

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  prerequisiteLessonId String?
  prerequisiteLesson   Lesson?  @relation("LessonPrerequisite", fields: [prerequisiteLessonId], references: [id])
  dependents           Lesson[] @relation("LessonPrerequisite")

  downloads LessonDownload[]
  quiz      Quiz?
  progress  LessonProgress[]

  @@unique([moduleId, order])
  @@index([moduleId])
}

model LessonDownload {
  id       String @id @default(cuid())
  fileName String
  fileUrl  String // Cloudflare R2 / S3 object URL

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

// Kept intentionally simple (JSON question bank) — a dedicated question/answer
// schema can replace this if quiz analytics become a requirement later.
model Quiz {
  id        String @id @default(cuid())
  questions Json

  lessonId String @unique
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

enum EnrollmentSource {
  STRIPE_PURCHASE
  MEMBERSHIP
  MANUAL
  FREE
}

enum EnrollmentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model Enrollment {
  id         String           @id @default(cuid())
  source     EnrollmentSource
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  certificates Certificate[]

  @@unique([userId, courseId])
  @@index([courseId])
}

model LessonProgress {
  id                   String    @id @default(cuid())
  completed            Boolean   @default(false)
  completedAt          DateTime?
  videoProgressSeconds Int       @default(0)
  updatedAt            DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model Certificate {
  id             String   @id @default(cuid())
  issuedAt       DateTime @default(now())
  certificateUrl String? // generated PDF stored in R2/S3

  userId String
  user   User   @relation(fields: [userId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])

  @@unique([userId, courseId])
}

// =============================================================================
// Orders / Payments (Stripe) — one-time purchases + subscriptions/memberships
// =============================================================================

enum ProductType {
  COURSE
  FUNNEL_OFFER
  MEMBERSHIP
  LISTING_UPGRADE
}

model Product {
  id              String      @id @default(cuid())
  name            String
  type            ProductType
  priceCents      Int
  currency        String      @default("usd")
  // Stripe Products/Prices are the source of truth (managed in the Stripe
  // Dashboard or API) and synced in here via product.*/price.* webhooks —
  // see apps/web/src/lib/billing/webhook-handlers.ts. `type` and `courseId`
  // come from the Stripe Product's metadata (metadata.type, metadata.courseId).
  // Since Phase 9, these events only ever arrive on a tenant's own connected
  // Stripe account (`event.account`), which is how tenantId is resolved.
  stripeProductId String?     @unique
  stripePriceId   String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id])

  // Phase 10: both set only for a LISTING_UPGRADE product, same optional-
  // field-per-type pattern courseId already established for COURSE.
  // listingTier is the ListingTier this purchase grants (parsed from Stripe
  // Product metadata.tier) — there's no other field to derive it from, since
  // a directory can sell more than one upgrade tier (e.g. Featured vs. Premium).
  listingId   String?
  listing     Listing?     @relation(fields: [listingId], references: [id])
  listingTier ListingTier?

  orders Order[]

  @@index([tenantId])
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
  CANCELED
  FAILED
}

model Order {
  id                      String      @id @default(cuid())
  email                   String
  amountCents             Int
  currency                String      @default("usd")
  status                  OrderStatus @default(PENDING)
  stripeCheckoutSessionId String?     @unique
  stripePaymentIntentId   String?     @unique
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id])

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id])

  funnelId String?
  funnel   Funnel? @relation(fields: [funnelId], references: [id])

  // Phase 10: set for a listing-upgrade purchase — same optional-FK-per-type
  // pattern courseId/dealId/funnelId already established.
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

// A User's subscription to one of a TENANT's membership products — distinct
// from PlatformSubscription (what the tenant pays the platform itself).
model Subscription {
  id                   String             @id @default(cuid())
  stripeSubscriptionId String             @unique
  stripeCustomerId     String
  plan                 String
  status               SubscriptionStatus
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
}

// A per-(Tenant,User) Stripe Customer object. Required because Stripe Connect
// customers live on the connected account, not the platform's — the same
// human buying from two different tenants is two different Stripe Customer
// objects, on two different Stripe accounts. Replaces the old single global
// User.stripeCustomerId (Phase 3), which only worked when there was one
// Stripe account for everyone.
model TenantCustomer {
  id               String   @id @default(cuid())
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
}

// Idempotency log for inbound Stripe webhook events.
model WebhookEvent {
  id            String    @id @default(cuid())
  stripeEventId String    @unique
  type          String
  payload       Json
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
}

// =============================================================================
// Marketing (Phase 7): Meta (Facebook/Instagram) campaign agent + insights.
// Scoped to Meta only for now — see CLAUDE.md for why TikTok/X/YouTube/Rumble
// are deferred. Every post is agent-drafted and human-approved before it ever
// reaches Meta's API — nothing here auto-publishes.
// =============================================================================

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
}

// A connected Facebook Page, or its linked Instagram Business account.
// accessTokenEncrypted is AES-256-GCM ciphertext (see lib/social/crypto.ts) —
// the token is never stored or logged in plaintext.
model SocialAccount {
  id                   String         @id @default(cuid())
  platform             SocialPlatform
  externalId           String // Facebook Page id, or Instagram Business Account id
  displayName          String
  accessTokenEncrypted String         @db.Text
  tokenExpiresAt       DateTime?
  connectedAt          DateTime       @default(now())
  disconnectedAt       DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  connectedByUserId String?
  connectedByUser   User?   @relation(fields: [connectedByUserId], references: [id])

  posts SocialPost[]

  // A real Facebook Page/IG account can only ever be connected to one
  // tenant at a time — this constraint is what enforces that, incidentally.
  @@unique([platform, externalId])
  @@index([tenantId])
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// A named grouping of posts (e.g. "Spring enrollment push"). Approval and
// publishing happen per-post, not per-campaign — a campaign can have posts
// at different stages at once.
model Campaign {
  id        String         @id @default(cuid())
  name      String
  goal      String? // the brief the agent was given, kept for context
  status    CampaignStatus @default(DRAFT)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id])

  posts SocialPost[]

  @@index([tenantId])
}

enum SocialPostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  REJECTED
}

// One planned or published post to one platform. The agent only ever creates
// rows in DRAFT/PENDING_APPROVAL — a human moving a post to APPROVED is what
// makes it eligible to publish; nothing here calls Meta's API on its own.
model SocialPost {
  id             String           @id @default(cuid())
  platform       SocialPlatform
  caption        String           @db.Text
  mediaUrl       String? // image/video URL Meta fetches when publishing — staff attaches this; the agent can't generate real media
  imageBrief     String?          @db.Text // agent's description of what visual belongs here, until staff attaches mediaUrl
  status         SocialPostStatus @default(DRAFT)
  scheduledFor   DateTime?
  publishedAt    DateTime?
  externalPostId String? // the id Meta returns once published
  error          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id])

  approvedByUserId String?
  approvedByUser   User?     @relation(fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?

  insights InsightSnapshot[]

  @@index([status])
  @@index([scheduledFor])
}

// A point-in-time pull of a published post's performance. The insights agent
// reads these rather than calling Meta's API itself on every question.
model InsightSnapshot {
  id         String   @id @default(cuid())
  metrics    Json // { reach, impressions, likes, comments, shares, clicks, ... } — shape varies by platform
  capturedAt DateTime @default(now())

  socialPostId String
  socialPost   SocialPost @relation(fields: [socialPostId], references: [id])

  @@index([socialPostId, capturedAt])
}

// =============================================================================
// Directory (Phase 10): a multi-tenant local-business directory builder,
// replicating/improving on smartdirectory.ai. Each Tenant builds ONE local
// business directory (a chamber-of-commerce/city-guide-style site) listing
// OTHER businesses — a Listing is just data our tenant owns, not another
// platform Tenant. Visitors browse/search it and can chat with an AI
// concierge agent; a listing's real-world owner can claim it and pay to
// upgrade its tier, settling on the tenant's own Stripe Connect account
// exactly like a course or membership purchase (see Product/Order below).
// =============================================================================

// One directory per tenant (kept 1:1 for this phase's scope — a tenant
// running two distinct directories, e.g. two different cities, is a real
// future need but not one anything currently asks for; revisit if it comes
// up rather than building the multi-directory UI speculatively now).
model Directory {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId String    @unique
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  categories DirectoryCategory[]
  listings   Listing[]
}

model DirectoryCategory {
  id    String @id @default(cuid())
  name  String
  slug  String
  order Int    @default(0)

  directoryId String
  directory   Directory @relation(fields: [directoryId], references: [id], onDelete: Cascade)

  listings Listing[]

  @@unique([directoryId, slug])
  @@index([directoryId])
}

enum ListingTier {
  FREE
  FEATURED
  PREMIUM
}

// Soft state via status, not deletion — same convention as Enrollment/Order
// elsewhere in this schema, so a listing's history (claim, past upgrades)
// survives it being taken down.
enum ListingStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

model Listing {
  id          String        @id @default(cuid())
  name        String
  slug        String
  description String?       @db.Text
  address     String?
  city        String?
  state       String?
  postalCode  String?
  phone       String?
  website     String?
  email       String?
  hours       Json? // free-form weekly hours — intentionally simple, same rationale as Quiz.questions
  photos      Json? // array of pasted R2/external URLs — no upload UI yet, matching Academy's downloads/quiz convention (no R2 credentials to build a real upload flow against)
  tier        ListingTier   @default(FREE)
  status      ListingStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Denormalized directly onto the row (not just reachable via directoryId)
  // for the same reason Order/Product carry tenantId despite being reachable
  // via a parent — simpler tenant-scoped queries and webhook dispatch,
  // matching this schema's established convention throughout Phase 8/9.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  directoryId String
  directory   Directory @relation(fields: [directoryId], references: [id], onDelete: Cascade)

  categoryId String?
  category   DirectoryCategory? @relation(fields: [categoryId], references: [id])

  // Claiming links a listing to the real business owner's platform User —
  // same "link an existing record to a User by an explicit action" pattern
  // signup.ts already uses for a funnel-sourced Contact.
  claimedByUserId String?
  claimedByUser   User?     @relation(fields: [claimedByUserId], references: [id])
  claimedAt       DateTime?

  products Product[]
  orders   Order[]

  @@unique([directoryId, slug])
  @@index([tenantId])
  @@index([directoryId, status])
}
